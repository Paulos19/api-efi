generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PixWebhook {
  id         String   @id @default(uuid())
  endToEndId String?  @unique // Made optional as it might not always be present initially
  txid       String   @unique
  valor      Float
  chave      String? // Made optional as it might not always be present initially
  status     String   @default("PENDING")
  horario    DateTime? // Made optional as it might not always be present initially
  payload    String?  // Added to store the webhook payload (as JSON string)
  characterId Int?    // Added to link to the character
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt // Good practice to track updates
}

