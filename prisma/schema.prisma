generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PixWebhook {
  id         Int      @id @default(autoincrement())
  endToEndId String
  txid       String   @unique
  valor      Float
  chave      String
  horario    DateTime
  createdAt  DateTime @default(now())
  status     String   @default("pending")
}
