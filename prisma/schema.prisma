generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PixWebhook {
  id         String   @id @default(uuid())
  endToEndId String   @unique
  txid       String   @unique
  valor      Float
  chave      String
  status     String   @default("PENDING")
  horario    DateTime
  createdAt  DateTime @default(now())
  User       User?    @relation(fields: [userId], references: [id])
  userId     Int?
}

model User {
  id          Int          @id @default(autoincrement())
  name        String
  email       String       @unique
  password    String
  coins       Float        @default(0)
  pixKey      String?      @unique
  pixWebhooks PixWebhook[] // Relacionamento com os webhooks
}
