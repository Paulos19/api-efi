generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StatusPix {
  PENDING
  COMPLETED
  FAILED
}

model PixWebhook {
  id            String     @id @default(uuid())
  endToEndId    String?    @unique
  txid          String     @unique
  valor         Float
  chave         String?
  status        StatusPix  @default(PENDING)
  horario       DateTime?
  createdAt     DateTime   @default(now())
  characterName String?
  payload       Json?
  Character     Character? @relation(fields: [characterId], references: [id])
  characterId   Int?

  @@index([txid, status])
}

model Character {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  coins       Int          @default(0)
  pixPayments PixWebhook[]
}
