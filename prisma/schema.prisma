generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Modelo para armazenar informações de webhooks PIX recebidos
model PixWebhook {
  id            String    @id @default(uuid())
  endToEndId    String?   @unique // Tornar opcional se puder ser nulo inicialmente
  txid          String    @unique
  valor         Float
  chave         String?   // Tornar opcional se puder ser nulo
  status        String    @default("PENDING")
  horario       DateTime? // Tornar opcional se puder ser nulo
  createdAt     DateTime  @default(now())
  characterName String?   // Adicionar este campo (opcional ou String)
  payload       Json?     // Adicionar campo para guardar o payload completo (opcional)
}

