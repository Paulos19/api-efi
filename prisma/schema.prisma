generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PixWebhook {
  id         String   @id @default(uuid())
  endToEndId String   @unique
  txid       String   @unique
  valor      Float
  chave      String
  status     String   @default("PENDING")
  horario    DateTime
  createdAt  DateTime @default(now())
}

