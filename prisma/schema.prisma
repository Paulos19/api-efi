generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Modelo para armazenar informações de webhooks PIX recebidos
model PixWebhook {
  id         String   @id @default(uuid())
  endToEndId String?  @unique // ID ponta-a-ponta do PIX (opcional, pode vir depois)
  txid       String   @unique // ID da transação gerado pela Gerencianet
  valor      Float    // Valor do PIX
  chave      String?  // Chave PIX utilizada (opcional)
  status     String   @default("PENDING") // Status do pagamento (ex: PENDING, COMPLETED, ERROR)
  horario    DateTime? // Horário da transação PIX (opcional, vem do webhook)
  payload    String?  // Payload JSON completo recebido do webhook (armazenado como string)
  characterId Int?    // ID do personagem associado (se aplicável, requer relação)
  createdAt  DateTime @default(now()) // Data e hora de criação do registro
  updatedAt  DateTime @updatedAt // Data e hora da última atualização do registro

  // Adicione aqui a relação com o modelo Character se necessário
  // character Character? @relation(fields: [characterId], references: [id])
}

